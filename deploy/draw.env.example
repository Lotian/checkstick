# 囍签后端环境变量
# 用法：复制到 /etc/xiqian/draw.env 并 chmod 600，然后填入真实值
#   install -m 600 deploy/draw.env.example /etc/xiqian/draw.env
#
# 注意：下面每一项都没有默认值，缺项后端会直接启动失败。
# 这是刻意设计的——避免用出厂的弱口令或误连到别的数据库上线。

# ---------- 数据库（Flyway 首次启动会自动建表，无需手工执行 SQL）----------
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/xiqian
DATABASE_USERNAME=xiqian
DATABASE_PASSWORD=在这里填数据库口令

# ---------- 管理端账号 ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=在这里填一个强口令

# ---------- 玩家端地址（决定后台打印出来的二维码指向哪里）----------
# 用公网 IP + HTTP 访问（无域名/未备案）→ 留空，前端会自动用当前访问地址
# 单域名部署：玩家端在 https://xxx/，后台在 https://xxx/admin/  → 留空
# 分域名部署：玩家端 h5.xxx.com，后台 admin.xxx.com            → 填 https://h5.xxx.com/
# 本地开发想扫到 5173 的玩家端                                  → 填 http://localhost:5173/
PUBLIC_BASE_URL=

# ---------- HTTPS ----------
# 用公网 IP + HTTP 访问时保持 false。
# 配置了域名并签好证书、走 HTTPS 之后，必须改成 true。
# （HTTP 下若为 true，浏览器不会回传会话 Cookie，表现是"登录成功后立刻又变回未登录"。）
APP_COOKIE_SECURE=false

# ---------- 其它 ----------
SERVER_PORT=8080

# 现场排查需要看 SQL 时临时打开（默认关闭，避免日志被刷满）：
#LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG
#LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=TRACE
#LOGGING_LEVEL_COM_XIQIAN=DEBUG
